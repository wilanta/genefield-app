{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeneField",
  "mainBinaryName": "GeneField",
  "version": "0.1.0",
  "identifier": "com.genefield.desktop",
  "build": {
    "beforeDevCommand": "node scripts/stage-runtime.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeneField",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:genefield.db"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/genefield-final-v1"
    ],
    "resources": {
      "binaries/_internal/": "_internal/",
      "resources/data/": "data/"
    }
  }
}
